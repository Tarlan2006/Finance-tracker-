{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:live": "npm run build && wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "predeploy": "npm run verify:release",
    "verify:release": "npm run check && npm run build && node scripts/check-secrets.mjs && node scripts/audit-artifacts.mjs && npm run test:e2e",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && tsc --noEmit && npm test",
    "smoke:read": "node scripts/smoke-read.mjs"
  },
  "overrides": { "minimatch@^10": "11.0.1" },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
